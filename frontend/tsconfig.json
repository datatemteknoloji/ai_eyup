{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@dropt/*": ["src/dropt/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/dropt/App.tsx",
    "src/dropt/main.tsx",
    "src/dropt/pages/LoginPage.tsx",
    "src/dropt/pages/DashboardPage.tsx",
    "src/dropt/pages/ServersPage.tsx",
    "src/dropt/pages/PortalUsersPage.tsx",
    "src/dropt/pages/AdminSystemPage.tsx",
    "src/dropt/components/AppShell.tsx",
    "src/dropt/components/AssistantFab.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
