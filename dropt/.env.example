POSTGRES_USER=dtt
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=dttportal

DATABASE_URL=postgresql+psycopg://dtt:change-me-postgres@db:5432/dttportal
REDIS_URL=redis://redis:6379/0

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
RESET_ADMIN_PASSWORD=false

# Ainew Level 1 bridge (ana .env AINEW_BRIDGE_SECRET ile aynı olmalı)
AINEW_BRIDGE_SECRET=replace-with-shared-bridge-secret

CORS_ORIGINS=https://localhost,http://localhost:3000

# SIEM audit forward (optional)
SIEM_ENABLED=false
SIEM_WEBHOOK_URL=
SIEM_TIMEOUT_SEC=5

# Optional (api container)
# PORTAL_SSH_KEY_DIR=/ssh-keys
# PORTAL_ARTIFACT_DIR=/artifacts
