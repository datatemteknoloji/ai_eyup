# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/

# build-distribution.sh çıktısı olan tek-dosya paket (dist/<isim>.tar.gz + .sha256) —
# scp/USB ile doğrudan taşımak isteyenler için üretilir, git'e dahil değil (GitHub'ın
# 100MB LFS'siz sınırını aşıyor). Git üzerinden dağıtım için dist/<isim>/ (açılmış
# paket, parçalanmış imajlarla) izlenir — bkz. deploy/README.md.
dist/*.tar.gz
dist/*.tar.gz.sha256
eggs/
.eggs/
# Python root build dirs (not frontend/src/lib)
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# Node
node_modules/
frontend/node_modules/
# node_modules altında olsa da .gitignore'daki node_modules/ kuralından ÖNCE
# yanlışlıkla commit edilmiş bir vitest cache dosyası vardı — kalıcı olarak
# yoksay (bkz. gstack-devex-review bulguları).
frontend/node_modules/.vite/vitest/results.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vite
frontend/.vite/
frontend/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local
.env.bak-rotate-*
.env.bak-*

# Prometheus target files are regenerated at runtime from the DB
# (sync_node_exporter_targets_from_db / sync_windows_exporter_targets_from_db) —
# don't ship this deployment's real server inventory via git.
prometheus/targets/*.json

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# Database
*.db
*.sqlite3

# Prometheus data
prometheus_data/

# Redis data
redis_data/

# Postgres data
postgres_data/

# Node exporter binaries
backend/static/node_exporter/
.gstack/

# RAG seed: büyük vendor PDF'leri repo'ya girmesin (README + manifest kalır)
docs/rag_seed/**
!docs/rag_seed/README.md
!docs/rag_seed/manifest.json
!docs/rag_seed/.gitkeep
