# 🔐 SECURITY (ZORUNLU!)
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_strong_password_123

# 🌐 CORS (Frontend domain whitelist)
CORS_ORIGINS=http://localhost:3000,http://192.168.1.222:3000

# 📊 Database
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/server_management

# 🤖 Ollama AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_AUTO_MODEL_ENABLED=true

# 🔍 Prometheus
PROMETHEUS_URL=http://localhost:9090
PUSHGATEWAY_URL=http://localhost:9091

# 📝 Logging
LOG_LEVEL=INFO

# 🔧 Backend
BACKEND_HOST=backend
BACKEND_PORT=8000

# 🔄 Redis
REDIS_URL=redis://localhost:6379/0

# 📂 Storage
RAG_CHROMA_PATH=/var/lib/server_management/chroma
NODE_EXPORTER_STORAGE_PATH=/app/static/node_exporter
NODE_EXPORTER_DISTRIBUTION_METHOD=scp

# AWX (Optional)
AWX_URL=
AWX_USERNAME=
AWX_PASSWORD=
