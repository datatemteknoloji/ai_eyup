# 🔐 SECURITY (ZORUNLU!)
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_strong_password_123
# İlk kurulumda oluşturulan admin kullanıcısı (yalnızca hiç kullanıcı yokken)
ADMIN_DEFAULT_PASSWORD=Kim13Sun

# 🌐 CORS (Frontend domain whitelist) — kurulum sunucunuzun gerçek adresini/domain'ini ekleyin
CORS_ORIGINS=http://localhost:3000

# 📊 Database
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/server_management

# 🤖 Ollama AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_AUTO_MODEL_ENABLED=true
# RAG embedding hedefi (boş = OLLAMA_URL). Chat REMOTE_LLM kullanırken bile
# yerel Ollama embedding için genelde http://127.0.0.1:11434 bırakın.
# EMBEDDING_URL=http://127.0.0.1:11434
# REMOTE_LLM_EMBED_MODEL=nomic-embed-text

# 🧠 AI Agent (tool-calling) ve Guard (safety classifier) modelleri
# Küçük/orta donanımda çalışacak gerçekçi varsayılanlar seçildi — daha güçlü bir
# donanımınız varsa (örn. büyük GPU) bu modelleri Ayarlar > AI Ayarları'ndan veya
# burada daha büyük bir modelle (örn. qwen3.5:35b) değiştirebilirsiniz. Seçtiğiniz
# modelin `ollama pull` ile önceden indirilmiş olması gerekir.
AGENT_MODEL=llama3.2:3b
AGENT_GUARD_ENABLED=false
AGENT_GUARD_MODEL=llama3.2:3b

# 🌉 Uzak AI Gateway (opsiyonel — OpenAI-uyumlu, örn. Bifrost)
# Ayarlanırsa (REMOTE_LLM_ENABLED=true + URL + model), TÜM chat/agent çağrıları
# yerel Ollama yerine buraya gider. API Key / Virtual Key isteğe bağlıdır.
# URL kökü olmalı (sonuna /v1/chat/completions EKLEMEYİN, kod otomatik ekler).
REMOTE_LLM_ENABLED=false
REMOTE_LLM_URL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=
REMOTE_LLM_TIMEOUT_SECONDS=120
# Kurumsal gateway'iniz self-signed sertifika kullanıyorsa ve
# "[SSL: CERTIFICATE_VERIFY_FAILED] self-signed certificate in certificate chain"
# hatası alıyorsanız iki seçeneğiniz var (önerilen sıraya göre):
#   1) REMOTE_LLM_CA_BUNDLE ile gateway'in (self-signed) sertifikasının/kurumsal CA'nın
#      PEM dosyasını verin — doğrulama AÇIK kalır, sadece bu ek sertifikaya da güvenilir.
#      Dosyayı backend container'ına mount etmeniz gerekir (bkz. docker-compose.prod.yml).
#   2) REMOTE_LLM_VERIFY_SSL=false ile doğrulamayı tamamen kapatın (daha az güvenli,
#      sadece güvendiğiniz bir iç ağ/gateway için kabul edilebilir).
REMOTE_LLM_VERIFY_SSL=true
REMOTE_LLM_CA_BUNDLE=

# RAG seed: host docs/rag_seed → container /app/docs/rag_seed
# İndeks Postgres rag_embeddings (pgvector). RAG_CHROMA_PATH container içi yoldur
# (compose ${DATA_DIR}/chroma → /app/chroma); kurulum dizinine göre değişmez.
# RAG_SEED_PATH=/app/docs/rag_seed

# 🔍 Prometheus
PROMETHEUS_URL=http://localhost:9090
PUSHGATEWAY_URL=http://localhost:9091

# 📝 Logging
LOG_LEVEL=INFO

# 🔧 Backend
BACKEND_HOST=backend
BACKEND_PORT=8000

# 🔄 Redis
REDIS_URL=redis://localhost:6379/0

# 📂 Storage (container içi; host tarafı DATA_DIR — install-rhel yazar)
RAG_CHROMA_PATH=/app/chroma
NODE_EXPORTER_STORAGE_PATH=/app/static/node_exporter
NODE_EXPORTER_DISTRIBUTION_METHOD=scp

# AWX (Optional)
AWX_URL=
AWX_USERNAME=
AWX_PASSWORD=

# Uygulama sürümü (UI / health). Boş bırakın — backend VERSION dosyasından okur.
# Bir değer girerseniz VERSION dosyasındaki güncellemeleri ezer (bkz. scale-and-performance.md).
APP_VERSION=

# Platform GUI self-update (yalnızca prod paket kurulumunda)
# Dev docker-compose.yml için false bırakın.
PLATFORM_UPDATE_ENABLED=false
AINEW_INSTALL_DIR=
# AINEW_DATA_DIR = DATA_DIR = $AINEW_INSTALL_DIR/data (install-rhel zorlar)
PLATFORM_UPDATER_IMAGE=alpine:3.20
# PLATFORM_UPDATE_MAX_UPLOAD_BYTES=8589934592

# Konteyner log saat dilimi (Europe/Istanbul = UTC+3)
TZ=Europe/Istanbul

# build-distribution.sh tarafından üretildi — bu paketteki imaj etiketleri
BACKEND_IMAGE=ainew-backend:1.0.9.26
FRONTEND_IMAGE=ainew-frontend:1.0.9.26

# ── Level 1 / Dropt Ops sidecar ─────────────────────────────────────────────
# Ainew ↔ Dropt auth bridge (install-rhel.sh üretir)
AINEW_BRIDGE_SECRET=GENERATE_WITH_openssl_rand_hex_24
DROPT_API_URL=http://127.0.0.1:8001
DROPT_POSTGRES_USER=dtt
DROPT_POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_16
DROPT_POSTGRES_DB=dttportal
DROPT_API_IMAGE=dropt-api:local
# Prod offline: never | Dev: missing
DROPT_PULL_POLICY=never

# Kalıcı veri kökü — her zaman uygulama dizininin altında: $INSTALL_DIR/data
# Örnek: kurulum /dttadvance/app ise DATA_DIR=/dttadvance/app/data
# install-rhel.sh / update-rhel.sh bunu ZORLA yazar. Compose: ${DATA_DIR:-./data}/...
DATA_DIR=
AINEW_DATA_DIR=
COMPOSE_PROJECT_NAME=ainew

# Chat / RAG — compose ve kod aynı default'u kullanır; .env'de yoksa bunlar geçer.
# Host kurulum yoluna bağlı değildir. UI Gelişmiş Ayarlar uvicorn/celery'yi override eder.
UVICORN_WORKERS=2
AINEW_SERVICE_ROLE=all
CHAT_AI_MAX_CONCURRENT=3
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
